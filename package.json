{
  "name": "@ziioai/jsonface",
  "version": "0.0.1",
  "description": "TypeScript-like declarations encoded as JSON, with TypeScript emission and Zod compilation.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "SPEC.md",
    "SPEC-CN.md",
    "LICENSE"
  ],
  "keywords": [
    "typescript",
    "json",
    "schema",
    "zod",
    "validation",
    "codegen"
  ],
  "author": "ziioai",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ziioai/jsonface.git"
  },
  "bugs": {
    "url": "https://github.com/ziioai/jsonface/issues"
  },
  "homepage": "https://github.com/ziioai/jsonface#readme",
  "engines": {
    "node": ">=20",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.23.0",
  "volta": {
    "node": "24.19.0",
    "pnpm": "11.23.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsup && tsc -b --emitDeclarationOnly --force",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run tests",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run check"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
